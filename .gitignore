node_modules/
dist/
.DS_Store
*.local
.vite/
.env
.env.*
!.env.example

# Local-only private media — never push binaries / never deploy to Pages.
# Only the gallery scaffold docs/placeholders stay trackable.
# External roots (e.g. D:\视频 via GALLERY_ROOT) are outside the repo and must
# never be copied under public/ or otherwise staged.
/private/**
!/private/gallery/
!/private/gallery/README.md
!/private/gallery/albums/
!/private/gallery/albums/.gitkeep

# One-line absolute path override for local gallery media root (e.g. D:\视频).
.gallery-root.local

# Copy to .env or .env.local for local use, or set the same name as a GitHub Actions secret.
VITE_SITE_PASSWORD=notes

# --- Visitor access logging (optional; all unset = no-op) ---
# POST JSON beacons (time, path, device, approx geo/IP) to your webhook / Worker / form sink.
# Examples: Cloudflare Worker, Pipedream, Make.com, n8n, webhook.site (testing).
# VITE_VISIT_LOG_ENDPOINT=https://example.com/visit-hook

# Approx IP/location via browser fetch to a public geo API (default on when endpoint set).
# Set to 0 to skip geo lookup. Override URL if you prefer another CORS-friendly API.
# VITE_VISIT_LOG_GEO=1
# VITE_VISIT_LOG_GEO_URL=https://ipapi.co/json/

# Optional privacy-friendly dashboards (pick one or combine with the beacon):
# Umami Cloud / self-host — script src + website id from the Umami UI
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=

# Plausible — data-domain for your Pages host (e.g. yushun-feng.github.io)
# VITE_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# GoatCounter — your site code (xxx in xxx.goatcounter.com)
# VITE_GOATCOUNTER_CODE=
